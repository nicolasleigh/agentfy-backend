APP_NAME="AI Chat Backend"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/v1

# Database:
#   PostgreSQL (production)  — postgresql+asyncpg://user:password@host:5432/dbname
#   SQLite (development)     — sqlite+aiosqlite:///./data/app.db
DATABASE_URL=postgresql+asyncpg://app:app_secret@localhost:5432/ai_chat

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider: "ollama" | "openai"
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (or any OpenAI-compatible API)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
